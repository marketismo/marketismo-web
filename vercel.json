{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/second-brain",
      "destination": "/second-brain/",
      "permanent": true
    },
    {
      "source": "/alma/dashboard",
      "destination": "/alma/dashboard/",
      "permanent": true
    },
    {
      "source": "/calendar",
      "destination": "/calendar/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/second-brain/",
      "destination": "https://second-brain-marketismo.vercel.app/"
    },
    {
      "source": "/second-brain/:path+",
      "destination": "https://second-brain-marketismo.vercel.app/:path+"
    },
    {
      "source": "/alma/dashboard/",
      "destination": "https://alma-platform-mockup.vercel.app/"
    },
    {
      "source": "/alma/dashboard/:path+",
      "destination": "https://alma-platform-mockup.vercel.app/:path+"
    },
    {
      "source": "/calendar/",
      "destination": "https://bc-calendar.vercel.app/"
    },
    {
      "source": "/calendar/:path+",
      "destination": "https://bc-calendar.vercel.app/:path+"
    }
  ]
}
